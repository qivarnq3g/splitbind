# Local course materials and private project evidence
# Restored 2026-09-11: the AgentConfig template .gitignore had overwritten these
# rules. They encode a deliberate decision that course PDFs, lecturer
# correspondence, and internal notes never enter the publication set.
/*.pdf
/*.docx
/*.xlsx
/note.txt
/docs/course/
/docs/internal/
/docs/project/lecturer-email-summary.md

# Bài tập cá nhân và bản nháp riêng, không thuộc sản phẩm nhóm nộp.
/docs/project/HoangVietQuang_BaiTapAffine.docx
/docs/project/affine-homework.md
/docs/project/forum-post-draft.md

# Ghi chép công việc nội bộ và sản phẩm trung gian của quá trình dựng tài liệu.
/docs/project/task-6-report.md
/docs/project/*.pre-cover.docx
# Chứa IP server production, email cá nhân, Azure subscription ID, endpoint R2
# và username quản trị. Bản thân file vẫn ở trên đĩa để dùng nội bộ.
/docs/evaluation/integrity-release-0.1.md

# Agent operating contract — local to each machine.
# Same intent as the rules above. Note: docs/knowledge/ and docs/project-context.md
# are deliberately NOT excluded any more; see the content boundary section in
# docs/project-context.md for what may and may not be written into them.
/AGENTS.md
/**/AGENTS.md
/CLAUDE.md
/**/CLAUDE.md
.claude/
.codex/
.antigravity/
.cursor/
/skills/

# Local-only agent and tooling state. Moved here from .git/info/exclude on
# 2026-09-11: that file is machine-local and never travels with the repository,
# so a publication decision written there is invisible to everyone who clones.
/.worktrees/
/.hallmark/

# Excluded because it records the production SSH administrator username.
/docs/superpowers/plans/2026-08-17-azure-vm-provisioning.md

# Agent scratch space — disposable by contract, never committed
scratch/
.scratch/
*.scratch.*
*.tmp
tmp/
temp/

# Environment and secrets
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
*.pfx

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Rust
/target/
**/target/

# Node.js and frontend
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# Runtime and disposable outputs
*.log
.cache/
artifacts/
reports/
*.swp

# Local infrastructure state
.lima/
.terraform/
*.tfstate
*.tfstate.*

# Gói bài nộp, dựng lại được từ nguồn nên không đưa vào repo.
/submission/
