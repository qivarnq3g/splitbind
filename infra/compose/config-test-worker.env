# Synthetic local parser input. Application production validation must reject it.
ENVIRONMENT=local
SPLITBIND_SYNTHETIC_CONFIG_ONLY=true
RABBITMQ_URL=amqp://splitbind_local:SYNTHETIC_CONFIG_TEST_ONLY_NOT_A_SECRET@rabbitmq:5672/%2f
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=splitbind-local
OBJECT_STORAGE_ACCESS_KEY=splitbind_local
OBJECT_STORAGE_SECRET_KEY=SYNTHETIC_CONFIG_TEST_ONLY_NOT_A_SECRET
MANIFEST_SIGNING_KEY_FILE=/run/secrets/manifest_signing_key
FINGERPRINT_KEY_FILE=/run/secrets/fingerprint_key
INTEGRITY_KEY_FILE=/run/secrets/integrity_key
