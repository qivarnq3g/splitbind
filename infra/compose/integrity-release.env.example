# Copy to a private deployment environment file and fill every blank value.
# Runtime images must be content-addressed release images, never mutable tags.
WEB_IMAGE=
API_IMAGE=
SPLITBIND_HOSTNAME=splitbind.qivarn.id.vn
ACME_EMAIL=
NEON_DATABASE_HOST=
R2_ENDPOINT=
API_ENV_FILE=/run/splitbind/secrets/api.env
WORKER_ENV_FILE=/run/splitbind/secrets/worker.env
MANIFEST_SIGNING_KEY_FILE=/run/splitbind/secrets/manifest-signing-key.pk8
MANIFEST_SIGNING_KEY_PASSPHRASE_FILE=/run/splitbind/secrets/manifest-signing-key.passphrase

# Docker builds also require caller-verified immutable references:
# --build-arg PYTHON_BASE_IMAGE=python@sha256:<verified-digest>
# --build-arg NODE_BASE_IMAGE=node@sha256:<verified-digest>
# --build-arg CADDY_BASE_IMAGE=caddy@sha256:<verified-digest>
